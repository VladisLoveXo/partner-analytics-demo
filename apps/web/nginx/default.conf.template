# Rendered by the nginx image on start: ${API_UPSTREAM} comes from the environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # The API sits behind the same origin: no CORS, and the browser never sees internal addresses.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # One id from the edge through partners-api and gRPC to stats-service logs.
        proxy_set_header X-Request-Id $request_id;
    }

    # Written on start from environment variables (40-app-config.sh).
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # File names carry a content hash, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routing: unknown paths get the SPA.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
